package layouts

import (
	"github.com/FortiBrine/VoidShift/internal/i18n"
	"github.com/FortiBrine/VoidShift/view/components/ui/button"
	"github.com/FortiBrine/VoidShift/view/components/ui/icon"
	"github.com/FortiBrine/VoidShift/view/components/ui/sidebar"
)

templ App(loc *i18n.Localizer, title string, active string) {
	@Shell(title) {
		@sidebar.Layout() {
			@sidebar.Sidebar() {
				@sidebar.Header() {
					<div class="flex items-center gap-2 px-2 py-1.5">
						@icon.Shield(icon.Props{Class: "size-5"})
						<span class="text-sm font-semibold">VoidShift</span>
					</div>
				}
				@sidebar.Content() {
					@sidebar.Group() {
						@sidebar.Menu() {
							@sidebar.MenuItem() {
								@sidebar.MenuButton(sidebar.MenuButtonProps{
									Href:     "/",
									IsActive: active == "dashboard",
								}) {
									@icon.LayoutDashboard(icon.Props{Class: "size-4"})
									<span>{ i18n.T(loc, "layout.dashboard") }</span>
								}
							}
							@sidebar.MenuItem() {
								@sidebar.MenuButton(sidebar.MenuButtonProps{
									Href:     "/wireguard",
									IsActive: active == "wireguard",
								}) {
									@icon.Router(icon.Props{Class: "size-4"})
									<span>WireGuard</span>
								}
							}
						}
					}
				}
				@sidebar.Footer() {
					<div class="flex items-center gap-2">
						@button.Button(button.Props{
							ID:      "theme-toggle",
							Type:    button.TypeButton,
							Variant: button.VariantOutline,
							Size:    button.SizeIcon,
							Class:   "relative shrink-0",
							Attributes: templ.Attributes{
								"aria-label": i18n.T(loc, "layout.toggle_theme"),
							},
						}) {
							@icon.Sun(icon.Props{Class: "size-4 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"})
							@icon.Moon(icon.Props{Class: "absolute size-4 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"})
						}
						<form method="post" action="/logout" class="flex-1">
							@button.Button(button.Props{
								Type:      button.TypeSubmit,
								Variant:   button.VariantOutline,
								FullWidth: true,
							}) {
								@icon.LogOut(icon.Props{Class: "size-4"})
								{ i18n.T(loc, "layout.logout") }
							}
						</form>
					</div>
				}
			}
			@sidebar.Inset() {
				<header class="flex items-center gap-3 border-b px-4 py-3">
					@sidebar.Trigger()
					<span class="text-sm font-medium text-muted-foreground">{ title }</span>
				</header>
				<main class="w-full max-w-5xl mx-auto flex-1 p-6">
					{ children... }
				</main>
			}
		}
		@sidebar.Script()
		<script>
			document.getElementById("theme-toggle").addEventListener("click", function () {
				var isDark = document.documentElement.classList.toggle("dark");
				document.cookie = "voidshift_theme=" + (isDark ? "dark" : "light") + ";path=/;max-age=31536000;samesite=lax";
			});
		</script>
	}
}
