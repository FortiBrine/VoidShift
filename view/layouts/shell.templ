package layouts

import (
	"github.com/FortiBrine/VoidShift/view/components/ui/input"
	"github.com/FortiBrine/VoidShift/view/components/ui/label"
)

templ Shell(title string) {
	<!DOCTYPE html>
	<html lang="en" class={ templ.KV("dark", isDarkFromContext(ctx)) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · VoidShift</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="bg-background text-foreground">
			{ children... }
			@input.Script()
			@label.Script()
		</body>
	</html>
}
