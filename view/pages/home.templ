package pages

import "github.com/FortiBrine/VoidShift/view/components/ui/button"

templ Home() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>VoidShift</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			@button.Button(button.Props{Variant: button.VariantDefault}) {
        		Get started
     		}
		</body>
	</html>
}
