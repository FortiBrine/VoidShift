package pages

import (
	"fmt"

	"github.com/FortiBrine/VoidShift/view/components/ui/button"
	"github.com/FortiBrine/VoidShift/view/components/ui/card"
	"github.com/FortiBrine/VoidShift/view/components/ui/icon"
	"github.com/FortiBrine/VoidShift/view/layouts"
)

templ PeerQR(peerID uint, networkID uint) {
	@layouts.App(fmt.Sprintf("QR peer-а #%d", peerID), "wireguard") {
		<div class="mb-6">
			@button.Button(button.Props{Href: backToNetworkPath(networkID), Variant: button.VariantGhost}) {
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Назад
			}
		</div>
		@card.Card(card.Props{Class: "max-w-xl"}) {
			@card.Header() {
				@card.Title() {
					{ fmt.Sprintf("QR peer-а #%d", peerID) }
				}
			}
			@card.Content(card.ContentProps{Class: "flex justify-center"}) {
				<img
					src={ fmt.Sprintf("/vpn/wireguard/peers/%d/qr", peerID) }
					alt="Peer QR code"
					class="w-full max-w-[460px]"
				/>
			}
		}
	}
}
